# Copy this file to .env (same folder) and adjust. Never commit .env.

# --- Application ---
# development | production
APP_ENV=development
# Public origin seen by the browser (SvelteKit front door). Used for Origin/CSRF checks and links.
APP_ORIGIN=http://localhost:5173
# Go API listens on loopback only; SvelteKit proxies /api, /auth, /health to it.
HTTP_ADDR=127.0.0.1:8080
# Used by SvelteKit (frontend) to reach the Go API. Must be a loopback address.
BACKEND_URL=http://127.0.0.1:8080
# debug | info | warn | error
LOG_LEVEL=info

# --- MySQL (WampServer MySQL 8.4 on port 3306; port 3307 is MariaDB - do not use) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=employee_leave_management
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_QUERY_TIMEOUT=5s

# --- Google OpenID Connect (Phase 2) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:5173/auth/google/callback
# Comma-separated. Applied only when the account is created for the first time.
BOOTSTRAP_ADMIN_EMAILS=xnnht1503@gmail.com

# --- Sessions (Phase 2) ---
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h
# At least 32 random bytes, base64. Generate in PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
SESSION_SECRET=

# --- Email ---
# An Admin turns email sending on/off in Cấu hình nghỉ phép → Email. When off, emails are only kept in the Email log.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=your Gmail, SMTP_PASSWORD=an App Password
# (Google Account > Security > 2-Step Verification > App passwords), SMTP_FROM=the same Gmail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- LIVE email & access (both empty/false = local development defaults) ---
# Email sending (to the real recipients) can only be turned on when this is true.
EMAIL_LIVE_ENABLED=false
# Who may sign in and receive email. Comma-separated exact addresses (e.g. Gmail test accounts) and/or a domain.
# Both empty = anyone with a Google account may sign in (still needs Admin activation). BOOTSTRAP_ADMIN_EMAILS always pass.
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAIN=
